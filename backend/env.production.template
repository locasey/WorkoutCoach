# =============================================================================
# Workout Coach - Production Environment Configuration
# =============================================================================
# Copy this file to .env and fill in the values for your production deployment.
# NEVER commit the actual .env file with real credentials!
# =============================================================================

# -----------------------------------------------------------------------------
# Database Configuration (Required)
# -----------------------------------------------------------------------------
# Neon PostgreSQL connection string
# Get from: https://console.neon.tech -> Your project -> Connection details
# Format: postgresql://user:password@ep-xxx.region.aws.neon.tech/dbname?sslmode=require
DATABASE_URL=<your-neon-connection-string>

# -----------------------------------------------------------------------------
# Flask Configuration (Required)
# -----------------------------------------------------------------------------
# Secure random key for session encryption (generate with: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=<generate-a-32-char-random-key>

# Environment setting - must be "production" for production
FLASK_ENV=production

# -----------------------------------------------------------------------------
# Authentication (Required for Production)
# -----------------------------------------------------------------------------
# Username and password for app access
AUTH_USERNAME=<your-username>
AUTH_PASSWORD=<your-secure-password>

# -----------------------------------------------------------------------------
# LLM Provider Configuration (Required)
# -----------------------------------------------------------------------------
# Provider: 'gemini' (default, free tier) or 'openai' (requires credits)
LLM_PROVIDER=gemini

# Gemini API Key (if using gemini)
# Get from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=<your-gemini-api-key>

# OpenAI API Key (if using openai instead)
# Get from: https://platform.openai.com/api-keys
# OPENAI_API_KEY=<your-openai-api-key>

# -----------------------------------------------------------------------------
# Strava OAuth Configuration (Optional - for Strava integration)
# -----------------------------------------------------------------------------
# Get from: https://www.strava.com/settings/api
# NOTE: Keep localhost for now until LOC-10 updates for production
STRAVA_CLIENT_ID=<your-strava-client-id>
STRAVA_CLIENT_SECRET=<your-strava-client-secret>
STRAVA_REDIRECT_URI=http://localhost:5000/api/strava/callback

# -----------------------------------------------------------------------------
# Production URLs (Required for Production)
# -----------------------------------------------------------------------------
# Frontend URL - used for OAuth callbacks and redirects
FRONTEND_URL=https://workoutcoach.liamocasey.com

# CORS Origins - comma-separated list of allowed origins
# Must match your frontend domain(s)
CORS_ORIGINS=https://workoutcoach.liamocasey.com

# -----------------------------------------------------------------------------
# Application Configuration
# -----------------------------------------------------------------------------
# Maximum number of workout plans allowed per user
MAX_WORKOUT_PLANS=5
